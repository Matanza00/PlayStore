# Optional. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Any Gemini model with a free tier.
GEMINI_MODEL=gemini-3.5-flash-lite

# Feedback form (/feedback). Free key from https://resend.com. Without it the form offers a mailto link instead.
RESEND_API_KEY=
# Where feedback is delivered. Defaults to support@nxcsol.com.
FEEDBACK_TO=support@nxcsol.com
# Must be an address on a domain verified in Resend. Defaults to "FirstPass <feedback@nxcsol.com>".
FEEDBACK_FROM=FirstPass <feedback@nxcsol.com>
